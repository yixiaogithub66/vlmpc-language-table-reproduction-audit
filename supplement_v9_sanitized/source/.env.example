# VLMPC VLM backend configuration.
# Copy this file to .env and fill in your own key.
#
# Option A: call an OpenAI-compatible third-party API directly from this project.
VLMPC_VLM_BACKEND=openai
VLMPC_OPENAI_BASE_URL=<OPENAI_COMPATIBLE_BASE_URL>
VLMPC_OPENAI_MODEL=gpt-4.1-mini
# Use "responses" for gateways that expose /responses, or "chat" for /chat/completions.
VLMPC_OPENAI_WIRE_API=responses
VLMPC_OPENAI_API_KEY=replace_with_your_api_key

# Optional: if you prefer keeping the key in an environment variable, leave
# VLMPC_OPENAI_API_KEY empty and set this variable name instead.
VLMPC_OPENAI_API_KEY_ENV=OPENAI_API_KEY

# Optional cache. Leave empty for strict no-cache experiments.
VLMPC_VLM_CACHE_DIR=

# Target-image selection. "auto" tries VLM image matching first and falls back
# to the detector/descriptor selector; "vlm" is strict VLM-only; "vision" is
# detector/descriptor-only for ablations.
VLMPC_TARGET_IMAGE_SELECTOR=auto

# Option B: use Codex CLI instead of the direct HTTP API.
# VLMPC_VLM_BACKEND=codex
# VLMPC_CODEX_HOME=<CODEX_HOME>
# VLMPC_CODEX_MODEL=gpt-5.5
